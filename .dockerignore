# Version control: `.git` deliberately stays in the build context because
# the builder bind-mounts it (read-only, ephemeral) to bake the commit SHA
# into /app/GIT_SHA. The Dockerfile never COPYs it, so it cannot leak into
# an image layer. Only the ignore file itself is excluded.
.gitignore

# Local virtual environment and Python caches
.venv
__pycache__/
*.py[co]
.pytest_cache/
.ruff_cache/

# Tests and samples are not needed at runtime
tests/
examples/

# CI configuration
.github/

# Environment files (keep the example so it is not leaked)
.env
.env.*
!.env.example

# Local Docker tooling
Dockerfile
compose.yaml
.dockerignore
