# QR Studio configuration
#
# These values match the defaults baked into the Docker image.
# In Dokploy, set variables in the service/application settings instead of
# committing them to the repository.

# Address and port the web UI listens on.
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL) used for rate limiting and input monitoring.
DATABASE_URL=postgresql+asyncpg://qrgen:password@db:5432/qrgen

# Rate limits per client (IP + User-Agent), daily window in UTC.
RATE_LIMIT_GENERATE_PER_DAY=250
RATE_LIMIT_PREVIEWS_PER_DAY=500
RATE_LIMIT_WINDOW_RETENTION_HOURS=48

# How long monitored inputs are kept.
INPUT_RETENTION_DAYS=30

# Global cap on request-body bytes buffered at once (spool to /tmp).
# Multipart bodies count double (the form parser may spool file parts to
# disk independently of the request spool). Beyond this the server answers
# 503 with Retry-After instead of filling the disk.
# The counter is per process: the server runs one Uvicorn worker per
# container (scale with separate replicas, not --workers > 1).
MAX_INFLIGHT_BODY_BYTES=33554432

# Admin panel. Generate the hash with: qrgen hash-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=change-me
# Set to true when served behind HTTPS (Dokploy/Traefik).
SESSION_HTTPS_ONLY=false

# Optional GeoLite2 database for the approximate country of clients.
GEOIP_DB_PATH=

# IPs/CIDRs of trusted reverse proxies (e.g. Traefik) whose
# X-Forwarded-For header is honored for rate limiting and login throttling.
# Leave empty to always use the direct peer address. Never use 0.0.0.0/0:
# any client could then spoof its IP.
# Example for Docker/Traefik: FORWARDED_ALLOW_IPS=172.18.0.0/16
FORWARDED_ALLOW_IPS=
